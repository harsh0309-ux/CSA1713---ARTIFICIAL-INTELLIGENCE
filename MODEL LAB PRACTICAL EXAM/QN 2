
import random

cities = [0, 1, 2, 3]
dist = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

def fitness(route):
    return sum(dist[route[i]][route[i+1]]
               for i in range(3)) + dist[route[3]][route[0]]

population = [
    [0] + random.sample([1, 2, 3], 3)
    for _ in range(10)
]

for _ in range(100):
    population.sort(key=fitness)
    new = population[:2]

    while len(new) < 10:
        p = random.choice(population[:5])
        q = random.choice(population[:5])
        child = p[:2] + [x for x in q if x not in p[:2]]
        if random.random() < 0.5:
            child[1], child[2] = child[2], child[1]
        new.append(child)

    population = new

best = min(population, key=fitness)

print("Shortest Route:", best + [best[0]])
print("Minimum Distance:", fitness(best))
