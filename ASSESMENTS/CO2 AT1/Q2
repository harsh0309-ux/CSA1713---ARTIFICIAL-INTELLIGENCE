import heapq
 
graph = {
    "Gate": {"Library": 120, "Canteen": 200},
    "Library": {"Gate": 120, "Lab": 150, "Hostel": 300},
    "Canteen": {"Gate": 200, "Hostel": 100, "Admin": 260},
    "Lab": {"Library": 150, "Auditorium": 350},
    "Hostel": {"Library": 300, "Canteen": 100, "Auditorium": 180},
    "Admin": {"Canteen": 260, "Auditorium": 120},
    "Auditorium": {"Lab": 350, "Hostel": 180, "Admin": 120}
}
h = {"Gate": 400, "Library": 330, "Canteen": 240,
     "Lab": 280, "Hostel": 160, "Admin": 110, "Auditorium": 0}
 
def astar(start, goal):
    pq = [(h[start], 0, start, [start])]
    best_g = {start: 0}
    while pq:
        f, g, node, path = heapq.heappop(pq)
        if g != best_g.get(node):
            continue
        if node == goal:
            return path, g
        for nxt, cost in graph[node].items():
            new_g = g + cost
            if new_g < best_g.get(nxt, float("inf")):
                best_g[nxt] = new_g
                heapq.heappush(pq, (new_g + h[nxt], new_g, nxt, path + [nxt]))
    return None, float("inf")
 
path, distance = astar("Gate", "Auditorium")
print("Route:", " -> ".join(path))
print("Shortest distance:", distance, "metres")
