graph = {}
n = int(input("Enter number of nodes: "))
for i in range(n):
    node = input("Enter node name: ")
    graph[node] = {}
    edges = int(input("Enter number of connected nodes: "))
    for j in range(edges):
        neighbour = input("Enter neighbour: ")
        cost = int(input("Enter cost: "))
        graph[node][neighbour] = cost
heuristic = {}
print("Enter heuristic values:")
for node in graph:
    heuristic[node] = int(input("h(" + node + ") = "))
start = input("Enter start node: ")
goal = input("Enter goal node: ")
open_list = [(heuristic[start], 0, start, [start])]
visited = set()
while open_list:
    open_list.sort()
    f, g, current, path = open_list.pop(0)
    if current == goal:
        print("Shortest path:", " -> ".join(path))
        print("Total cost:", g)
        break
    if current in visited:
        continue
    visited.add(current)
    for neighbour, cost in graph[current].items():
        if neighbour not in visited:
            new_g = g + cost
            new_f = new_g + heuristic[neighbour]
            open_list.append(
                (new_f, new_g, neighbour, path + [neighbour])
            )
else:
    print("No path found.")
