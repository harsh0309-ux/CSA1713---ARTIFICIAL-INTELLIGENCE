
% Monkey Banana Problem

% State: state(MonkeyPosition, MonkeyStatus,
%              BoxPosition, BananaStatus)

% Monkey can walk from one position to another
move(state(P, onfloor, B, H),
     walk(P1),
     state(P1, onfloor, B, H)) :-
    P \= P1.

% Monkey pushes the box towards the banana
move(state(P, onfloor, P, H),
     push(P, P1),
     state(P1, onfloor, P1, H)) :-
    P \= P1.

% Monkey climbs onto the box
move(state(P, onfloor, P, H),
     climb,
     state(P, onbox, P, H)).

% Monkey grabs the banana
move(state(middle, onbox, middle, hasnot),
     grab,
     state(middle, onbox, middle, has)).

% Goal condition
goal(state(_, _, _, has)).

% Solution using recursion
solve(State, Plan) :-
    solve(State, [State], Plan).

solve(State, _, []) :-
    goal(State).

solve(State, Visited, [Action | Rest]) :-
    move(State, Action, NewState),
    \+ member(NewState, Visited),
    solve(NewState, [NewState | Visited], Rest).
